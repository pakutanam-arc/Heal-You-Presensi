rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Tier 1 Admin: Strictly verified paku.tanam@gmail.com
    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'paku.tanam@gmail.com';
    }

    // Validation Blueprint: Workshop
    function isValidWorkshop(data) {
      return data.keys().hasAll([
          'workshopId',
          'ownerId',
          'name',
          'date',
          'startTime',
          'location',
          'organizer',
          'tagline',
          'eventLabel',
          'customLogoUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'workshopId',
          'ownerId',
          'name',
          'date',
          'startTime',
          'location',
          'organizer',
          'tagline',
          'eventLabel',
          'customLogoUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.workshopId is string
        && data.workshopId.size() >= 1
        && data.workshopId.size() <= 64
        && data.workshopId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200
        && data.date is string
        && data.date.size() >= 1
        && data.date.size() <= 40
        && data.startTime is string
        && data.startTime.size() >= 1
        && data.startTime.size() <= 64
        && data.location is string
        && data.location.size() >= 1
        && data.location.size() <= 200
        && data.organizer is string
        && data.organizer.size() >= 1
        && data.organizer.size() <= 120
        && data.tagline is string
        && data.tagline.size() >= 1
        && data.tagline.size() <= 120
        && data.eventLabel is string
        && data.eventLabel.size() >= 1
        && data.eventLabel.size() <= 120
        && data.customLogoUrl is string
        && data.customLogoUrl.size() <= 350000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: Participant
    function isValidParticipant(data) {
      return data.keys().hasAll([
          'id',
          'workshopId',
          'ownerId',
          'name',
          'email',
          'institution',
          'role',
          'phone',
          'status',
          'checkInTime',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'workshopId',
          'ownerId',
          'name',
          'email',
          'institution',
          'role',
          'phone',
          'status',
          'checkInTime',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.workshopId is string
        && data.workshopId.size() >= 1
        && data.workshopId.size() <= 64
        && data.workshopId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.email is string
        && data.email.size() >= 1
        && data.email.size() <= 160
        && data.institution is string
        && data.institution.size() >= 1
        && data.institution.size() <= 160
        && data.role is string
        && data.role.size() >= 1
        && data.role.size() <= 100
        && data.phone is string
        && data.phone.size() <= 60
        && data.status is string
        && (data.status == 'PENDING' || data.status == 'PRESENT' || data.status == 'LATE')
        && data.checkInTime is string
        && data.checkInTime.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /workshops/{workshopId}
    match /workshops/{workshopId} {
      // Single-document get for verified staff and Admin (no collection list needed)
      allow get: if isVerifiedUser()
        && isValidId(workshopId)
        && (resource == null || existing().workshopId == workshopId || existing().ownerId == request.auth.uid || workshopId == 'main');

      // Initial bootstrap of 'main' workshop or Admin creating a new workshop event
      allow create: if isVerifiedUser()
        && isValidId(workshopId)
        && isValidWorkshop(incoming())
        && incoming().workshopId == workshopId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || workshopId == 'main');

      // Only Admin (paku.tanam@gmail.com) can update Workshop Config
      allow update: if isAdmin()
        && isValidId(workshopId)
        && isValidWorkshop(incoming())
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'workshopId',
            'ownerId',
            'name',
            'date',
            'startTime',
            'location',
            'organizer',
            'tagline',
            'eventLabel',
            'customLogoUrl',
            'createdAt',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin()
        && isValidId(workshopId);

      // Subcollection: /workshops/{workshopId}/participants/{participantId}
      match /participants/{participantId} {
        allow get: if isVerifiedUser()
          && isValidId(workshopId)
          && isValidId(participantId)
          && (resource == null || existing().workshopId == workshopId);

        // Secure List Query: Bound to exact equality workshopId == workshopId
        allow list: if isVerifiedUser()
          && existing().workshopId == workshopId;

        // Only Admin can create new participants (or initial atomic bootstrap when 'main' does not exist yet)
        allow create: if isVerifiedUser()
          && isValidId(workshopId)
          && isValidId(participantId)
          && isValidParticipant(incoming())
          && incoming().id == participantId
          && incoming().workshopId == workshopId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              workshopId == 'main'
              && !exists(/databases/$(database)/documents/workshops/main)
              && getAfter(/databases/$(database)/documents/workshops/main).data.workshopId == 'main'
            )
          );

        // Tiered Update Logic:
        // - Tier 1 (Admin): Can edit participant profile fields, reset, or check-in
        // - Tier 2 (Verified Staff): Can ONLY update attendance check-in status & checkInTime
        allow update: if isVerifiedUser()
          && isValidId(workshopId)
          && isValidId(participantId)
          && incoming().workshopId == existing().workshopId
          && incoming().id == existing().id
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/workshops/$(workshopId))
          && (
            // Tier 2 (All Verified Staff & Admin): Check-in or Undo Check-in only
            (
              incoming().ownerId == existing().ownerId
              && incoming().createdAt == existing().createdAt
              && incoming().status is string
              && (incoming().status == 'PENDING' || incoming().status == 'PRESENT' || incoming().status == 'LATE')
              && incoming().checkInTime is string
              && incoming().checkInTime.size() <= 64
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkInTime', 'updatedAt'])
            )
            ||
            // Tier 1 (Admin Only): Full participant profile edit or reset
            (
              isAdmin()
              && isValidParticipant(incoming())
              && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'ownerId',
                'name',
                'email',
                'institution',
                'role',
                'phone',
                'status',
                'checkInTime',
                'createdAt',
                'updatedAt'
              ])
            )
          );

        // Only Admin can delete participants
        allow delete: if isAdmin()
          && isValidId(workshopId)
          && isValidId(participantId)
          && exists(/databases/$(database)/documents/workshops/$(workshopId));
      }
    }
  }
}
